{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "declaration": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "test"
  ],
  "exclude": [
    ".worktrees/**",
    "experiments/**",
    "dist/**",
    "node_modules/**"
  ]
}